/// @notice Delegates existing contract administration to Claus, with founder recovery.
/// @dev Uses CALL, never DELEGATECALL. Upgrade authority remains a privileged trust.
contract ClausAdministrator is Ownable2Step, ReentrancyGuard {
    struct Call { address target; uint256 value; bytes data; }
    address public operator;
    mapping(address => bool) public managedTarget;

    error Unauthorized();
    error InvalidTarget();
    error InvalidCall();
    error OwnerRecoveryOnly();
    error CannotRenounce();
    event OperatorChanged(address indexed previous, address indexed current);
    event TargetChanged(address indexed target, bool enabled);
    event Executed(address indexed actor, address indexed target, bytes4 indexed selector, uint256 value, bytes32 dataHash);

    constructor(address founder, address operator_, address[] memory targets) Ownable_1(founder) {
        _setOperator(operator_);
        for (uint256 i; i < targets.length; ++i) _setTarget(targets[i], true);
    }

    function setOperator(address next) external onlyOwner { _setOperator(next); }
    function setTarget(address target, bool enabled) external onlyOwner { _setTarget(target, enabled); }
    function renounceOwnership() public pure override { revert CannotRenounce(); }

    function _setOperator(address next) private {
        if (next == address(this)) revert InvalidTarget();
        emit OperatorChanged(operator, next);
        operator = next; // zero revokes delegated access
    }
    function _setTarget(address target, bool enabled) private {
        if (target == address(this) || (enabled && target.code.length == 0)) revert InvalidTarget();
        managedTarget[target] = enabled;
        emit TargetChanged(target, enabled);
    }

    /// @notice Supports future selectors on the same managed proxy addresses.
    /// No selector registry or token redeployment is required for new hook logic.
    function execute(Call[] calldata calls) external payable nonReentrant returns (bytes[] memory results) {
        if (msg.sender != owner() && msg.sender != operator) revert Unauthorized();
        if (calls.length == 0 || calls.length > 32) revert InvalidCall();
        results = new bytes[](calls.length);
        for (uint256 i; i < calls.length; ++i) {
            Call calldata c = calls[i];
            if (!managedTarget[c.target] || c.target.code.length == 0) revert InvalidTarget();
            if (c.data.length < 4) revert InvalidCall();
            bytes4 selector = bytes4(c.data[:4]);
            // Routine delegated work cannot accidentally discard founder recovery.
            // Fully privileged replacement implementations must still be reviewed.
            if (selector == Ownable_1.renounceOwnership.selector) revert CannotRenounce();
            if (selector == Ownable_1.transferOwnership.selector && msg.sender != owner()) revert OwnerRecoveryOnly();
            (bool success, bytes memory result) = c.target.call{value:c.value}(c.data);
            if (!success) assembly ("memory-safe") { revert(add(result, 32), mload(result)) }
            results[i] = result;
            emit Executed(msg.sender, c.target, selector, c.value, keccak256(c.data));
        }
    }

    /// @notice Recover native coin accidentally returned to this administrator.
    function recoverNative(address payable recipient, uint256 amount) external onlyOwner nonReentrant {
        if (recipient == address(0)) revert InvalidTarget();
        (bool success,) = recipient.call{value:amount}("");
        if (!success) revert InvalidCall();
    }
    receive() external payable {}
}

